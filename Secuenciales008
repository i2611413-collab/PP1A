
# EJERCICIO 08 - AREA DE UN TERRENO

print("CALCULO DEL AREA DEL TERRENO")

A = float(input("Ingrese medida A: "))
B = float(input("Ingrese medida B: "))
C = float(input("Ingrese medida C: "))

# Calculo del area del trapecio

area = (B * (A + C)) / 2

print("\nRESULTADO")
print("Medida A:", A)
print("Medida B:", B)
print("Medida C:", C)
print("Area del terreno:", round(area, 2), "m2")
