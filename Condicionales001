
# EJERCICIO 01 - COMPRA DE LLANTAS

cantidad = int(input("Ingrese cantidad de llantas: "))

if cantidad <= 0:
    print("Cantidad no valida")
else:
    if cantidad < 5:
        precio = 150
    else:
        precio = 120

    total = cantidad * precio

    print("Precio por llanta: S/", precio)
    print("Total a pagar: S/", total)

