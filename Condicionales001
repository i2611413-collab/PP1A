INICIO
    DEFINIR cantidad COMO ENTERO
    DEFINIR precio, total COMO REAL

    LEER cantidad

    SI cantidad > 0 ENTONCES
        SI cantidad < 5 ENTONCES
            precio <- 150
        SINO
            precio <- 120
        FIN SI

        total <- cantidad * precio

        ESCRIBIR precio
        ESCRIBIR total
    SINO
        ESCRIBIR "Cantidad no valida"
    FIN SI
FIN
