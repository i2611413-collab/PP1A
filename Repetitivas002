
# EJERCICIO 02
# Clasificacion de 10 numeros

pares = 0
impares = 0
positivos = 0
neutros = 0
negativos = 0

for i in range(1, 11):

    numero = int(input(f"Ingrese el numero {i}: "))

    if numero % 2 == 0:
        pares += 1
    else:
        impares += 1

    if numero > 0:
        positivos += 1
    elif numero == 0:
        neutros += 1
    else:
        negativos += 1

print("\nRESULTADOS")
print("Numeros pares:", pares)
print("Numeros impares:", impares)
print("Numeros positivos:", positivos)
print("Numeros neutros:", neutros)
print("Numeros negativos:", negativos)
