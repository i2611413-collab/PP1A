
# EJERCICIO 06
# Cronometro HH:MM:SS

import time

horas = 0
minutos = 0
segundos = 0

print("CRONOMETRO")
print("Presione CTRL + C para detenerlo.")

try:
    while True:

        print(
            f"\r{horas:02d}:{minutos:02d}:{segundos:02d}",
            end="",
            flush=True
        )

        time.sleep(1)

        segundos += 1

        if segundos == 60:
            segundos = 0
            minutos += 1

        if minutos == 60:
            minutos = 0
            horas += 1

        if horas == 24:
            horas = 0

except KeyboardInterrupt:
    print("\nCronometro detenido.")
