
# EJERCICIO 03 - PORCENTAJE DE INVERSION

i1 = float(input("Inversion del socio 1: S/ "))
i2 = float(input("Inversion del socio 2: S/ "))
i3 = float(input("Inversion del socio 3: S/ "))

total = i1 + i2 + i3

p1 = (i1 / total) * 100
p2 = (i2 / total) * 100
p3 = (i3 / total) * 100

print("\nCAPITAL TOTAL: S/", total)
print("Participacion socio 1:", round(p1, 2), "%")
print("Participacion socio 2:", round(p2, 2), "%")
print("Participacion socio 3:", round(p3, 2), "%")
