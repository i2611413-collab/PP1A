
# EJERCICIO 05 - TRIANGULOS

import math

a = float(input("Ingrese lado A: "))
b = float(input("Ingrese lado B: "))
c = float(input("Ingrese lado C: "))

if a <= 0 or b <= 0 or c <= 0:
    print("Los lados deben ser positivos.")

elif a + b <= c or a + c <= b or b + c <= a:
    print("Los lados no forman un triangulo.")

elif a == b and b == c:
    perimetro = a + b + c
    print("Triangulo equilatero")
    print("Perimetro:", perimetro)

elif a == b or a == c or b == c:
    print("Triangulo isosceles")

    if a == b:
        print("Lados iguales: A y B")
    elif a == c:
        print("Lados iguales: A y C")
    else:
        print("Lados iguales: B y C")

else:
    s = (a + b + c) / 2
    area = math.sqrt(s * (s-a) * (s-b) * (s-c))

    print("Triangulo escaleno")
    print("Area:", round(area, 2))
