
# EJERCICIO 01
# Suma y promedio de numeros pares e impares

print("CALCULO DE PARES E IMPARES")

n = int(input("Ingrese el valor de N: "))

suma_pares = 0
suma_impares = 0
contador_pares = 0
contador_impares = 0

for numero in range(1, n + 1):

    if numero % 2 == 0:
        suma_pares += numero
        contador_pares += 1
    else:
        suma_impares += numero
        contador_impares += 1

if contador_pares > 0:
    promedio_pares = suma_pares / contador_pares
else:
    promedio_pares = 0

if contador_impares > 0:
    promedio_impares = suma_impares / contador_impares
else:
    promedio_impares = 0

print("\nRESULTADOS")
print("Suma de pares:", suma_pares)
print("Promedio de pares:", promedio_pares)
print("Suma de impares:", suma_impares)
print("Promedio de impares:", promedio_impares)
